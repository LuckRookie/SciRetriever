  "cards": [
    {
      "dot": "cyan",
      "title": "统一事实边界",
      "items": [
        "MetaLiterature 与 Literature 负责身份和当前业务事实",
        "SQLite 保存 catalog，文件系统保存不可变资产字节",
        "Storage 持久化已确认结果，不替业务模块做决定"
      ]
    },
    {
      "dot": "emerald",
      "title": "增量处理闭环",
      "items": [
        "发现、全文补全、查询和导入导出读取同一数据库",
        "Acquisition、Parsing、Analysis 可逐阶段提交有效事实",
        "后续失败保留已接纳资产、provenance 与 lineage"
      ]
    },
    {
      "dot": "amber",
      "title": "外部服务边界",
      "items": [
        "Provider、Browser、MinerU 与 LLM 经专属 adapter 访问",
        "MinerU 是 operator-managed parser backend，不是产品状态所有者",
        "共享 Network 与 Credential owner 执行准入、限额和凭据隔离"
      ]
    }
