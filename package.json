{
  "name": "sciretriever-typescript-workspace",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "preview:browser": "pnpm --filter @sciretriever/web preview",
    "build": "tsc -b && node scripts/build-workbench-assets.mjs",
    "package:portable": "node scripts/package/build-portable.mjs",
    "format": "prettier --write package.json pnpm-workspace.yaml tsconfig*.json eslint.config.mjs scripts/**/*.mjs packages/**/*.ts apps/**/*.ts",
    "format:check": "prettier --check package.json pnpm-workspace.yaml tsconfig*.json eslint.config.mjs scripts/**/*.mjs packages/**/*.ts apps/**/*.ts",
    "lint": "eslint \"scripts/**/*.mjs\" \"packages/**/*.ts\" \"apps/**/*.ts\" --no-error-on-unmatched-pattern",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "vitest run --passWithNoTests=false",
    "quick": "pnpm format:check && pnpm lint && pnpm typecheck",
    "full": "pnpm quick && pnpm test && pnpm build",
    "build:workbench": "pnpm build",
    "preview:workbench": "pnpm build:workbench && node apps/server/dist/entry/workbench-preview.js",
    "sciretriever": "node apps/server/dist/cli/main.js"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "24.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.35.0",
    "playwright": "1.55.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.4"
  }
}
