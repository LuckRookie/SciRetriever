{
  "name": "@sciretriever/server",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/web/reader/**",
    "dist/web/react/**",
    "dist/web/auth.html",
    "dist/web/auth.css",
    "dist/web/auth-fonts.json",
    "dist/web/auth-fonts/*.woff2"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "sciretriever": "./dist/cli/main.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-compaction": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-token-meter": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@inquirer/prompts": "^8.7.2",
    "@modelcontextprotocol/sdk": "1.27.1",
    "@napi-rs/canvas": "1.0.11",
    "@sciretriever/contracts": "workspace:*",
    "ajv": "8.17.1",
    "chalk": "^6.0.0",
    "cloakbrowser": "0.5.8",
    "playwright": "1.55.0",
    "playwright-core": "1.55.0",
    "string-width": "^8.2.2",
    "tldts": "7.4.16",
    "wrap-ansi": "^10.0.1",
    "ws": "8.22.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
