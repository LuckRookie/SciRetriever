{
  "schema_version": 1,
  "platform": "linux-x64",
  "node": "22.19.0",
  "package_manager": "pnpm@10.32.1",
  "playwright": "1.55.0",
  "cloakbrowser_wrapper": "0.5.8",
  "cloakbrowser_binary": "146.0.7680.177.5",
  "system_commands": ["flock", "prlimit", "Xvfb"],
  "browser_runtime": {
    "management": "operator-installed",
    "environment": "SCIRETRIEVER_CLOAK_BUNDLE",
    "stock_chromium_fallback": false
  },
  "licenses": {
    "playwright": "Apache-2.0",
    "playwright-core": "Apache-2.0",
    "cloakbrowser-wrapper": "MIT",
    "cloakbrowser-binary": "operator-supplied; verify distribution rights separately",
    "sciretriever": "MIT",
    "mupdf": "AGPL-3.0-or-later (separate process; COPYING and source manifest bundled)"
  },
  "bundled_tools": {
    "mupdf": {
      "version": "1.28.6",
      "executable": "runtime/mupdf/bin/mutool",
      "environment": "SCIRETRIEVER_MUPDF",
      "build": "pnpm build (verified bundle kept; otherwise pinned source fetched and compiled; failure fails the build)",
      "minimum_glibc": "2.38"
    }
  },
  "startup_requirements": {
    "checked_by": ["sciretriever web", "sciretriever doctor"],
    "parts": ["mupdf", "flock", "prlimit"],
    "on_missing": "refuse to start"
  }
}
